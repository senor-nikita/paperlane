{
  "name": "paperlane",
  "version": "0.0.3",
  "description": "Desktop PDF reader",
  "author": "senor_niki",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "dev": "electron-vite dev",
    "dist": "electron-vite build && npm run lizenztexte && electron-builder",
    "dist:win": "electron-vite build && npm run lizenztexte && electron-builder --win",
    "lizenztexte": "node scripts/generate-lizenztexte.mjs",
    "fixtures": "node scripts/generate-fixtures.mjs",
    "fixtures:check": "node scripts/assert-fixtures.mjs --deterministic",
    "format": "prettier --write .",
    "guard-build:preload-cjs": "node scripts/assert-preload-cjs.mjs",
    "guard:brand": "node scripts/assert-brand.mjs",
    "guard:fixtures": "node scripts/assert-fixtures.mjs",
    "guard:kein-updater": "node scripts/assert-kein-updater.mjs",
    "guard:lizenztexte": "node scripts/assert-lizenztexte.mjs",
    "guard:netzwerk": "node scripts/assert-kein-netzwerk.mjs",
    "guard:sprache": "node scripts/assert-sprache.mjs",
    "guard:third-party": "node scripts/assert-third-party.mjs",
    "guards": "run-s guard:*",
    "guards:build": "run-s guard-build:*",
    "icons": "node scripts/generate-icons.mjs",
    "lint": "run-s lint:eslint lint:prettier",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier --check .",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:cov": "vitest run --coverage && node scripts/coverage-changed.mjs",
    "test:e2e": "playwright test --project=electron --project=chrome",
    "test:perf": "playwright test --project=perf",
    "third-party": "node scripts/generate-third-party.mjs",
    "typecheck": "run-s typecheck:node typecheck:web typecheck:test",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "verify": "run-s typecheck lint test:cov guards",
    "verify:full": "run-s build verify guards:build test:e2e test:perf"
  },
  "dependencies": {
    "@pdf-lib/standard-fonts": "1.0.0",
    "docx": "9.7.2",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@playwright/test": "1.62.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "electron": "44.1.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.0.1",
    "mammoth": "1.12.3",
    "npm-run-all2": "9.0.3",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
